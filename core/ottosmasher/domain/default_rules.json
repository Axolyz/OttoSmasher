{
  "_comment": "用户可编辑规则的默认值（P10）。source.infer_rules：原片文件名（不含扩展名）从上到下 search，第一条匹配生效；命名组 work / episode。",
  "source.infer_rules": [
    "^\\[[^\\]]*\\]\\s*(?P<work>[^\\[\\]]+?)\\s*\\[(?P<episode>(?!(?:19|20)\\d\\d[\\]】])\\d{1,4})(?:v\\d+)?(?:\\s*END)?\\]",
    "^[\\[【][^\\]】]*[\\]】]\\s*[\\[【](?P<work>[^\\]】]+)[\\]】]\\s*[\\[【](?P<episode>(?!(?:19|20)\\d\\d[\\]】])\\d{1,4})(?:v\\d+)?(?:\\s*END)?[\\]】]",
    "^[\\[【](?P<work>[^\\]】]+)[\\]】]\\s*[\\[【](?P<episode>(?!(?:19|20)\\d\\d[\\]】])\\d{1,4})(?:v\\d+)?(?:\\s*END)?[\\]】]",
    "^(?:\\[[^\\]]*\\]\\s*)?(?P<work>.+?)\\s+[-–—－]\\s+(?P<episode>\\d{1,4})(?:v\\d+)?(?=$|[\\s\\[(（])",
    "^(?:\\[[^\\]]*\\]\\s*)?(?P<work>.+?)\\s*第\\s*(?P<episode>\\d{1,4})\\s*[話话集]",
    "^\\[[^\\]]*\\]\\s*(?P<work>[^\\[\\]]+?)\\s*(?:\\[|$)",
    "^\\[[^\\]]*\\]\\s*\\[(?P<work>[^\\]]+)\\]"
  ],
  "source.infer_samples": [
    "[VCB-Studio] Yuru Yuri [01][1080p]",
    "[DBD-Raws][Kemono Friends][02][1080P]",
    "[Kemono Friends][01]",
    "作品名 - 01"
  ]
}
