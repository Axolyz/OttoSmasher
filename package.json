{
  "name": "ottosmasher",
  "productName": "OttoSmasher",
  "version": "0.1.9",
  "private": true,
  "description": "音MAD 素材工作站",
  "main": "out/main/main.cjs",
  "type": "module",
  "scripts": {
    "build:main": "node tools/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev": "node tools/dev.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "native:build": "node tools/build-native.mjs",
    "i18n:check": "node tools/i18n-check.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.6.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "node-addon-api": "8.9.2",
    "node-gyp": "13.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron@44.6.0": true
  }
}
